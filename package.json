{
  "name": "@local/dsh-tts-service",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Loads the local Qwen3-TTS model with DSH and provides a sidebar panel to drive it",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
